# Slate CMS, Apache configuration
Options -Indexes
DirectoryIndex index.php
ServerSignature Off

<IfModule mod_rewrite.c>
    RewriteEngine On
    # RewriteBase /   (uncomment & adjust when installed in a sub-folder)

    # Block direct access to sensitive files and folders. Blocked paths answer 404 (not 403),
    # so scanners cannot even tell that they exist.
    RewriteRule ^(config\.php|config\.sample\.php|composer\.(json|lock)|package(-lock)?\.json|playwright\.config\.\w+|\.git.*|.*\.sqlite|.*\.log|.*\.md)$ - [R=404,L,NC]
    RewriteRule (^|/)\.(?!well-known/) - [R=404,L,NC]
    RewriteRule (^|/)(module|theme)\.json$ - [R=404,L,NC]
    RewriteCond %{REQUEST_URI} !/content/uploads/
    RewriteRule \.(example|dist|bak|old|orig|save|swp|sql|gz|tgz|tar)$ - [R=404,L,NC]
    RewriteRule ^content/(backups|cache)(/.*)?$ - [R=404,L,NC]
    RewriteRule ^(core|modules|content/backups|content/cache)/.*\.(php\d?|phtml|phar|inc)$ - [R=404,L,NC]
    RewriteRule ^content/.*\.(sqlite|log|zip)$ - [R=404,L,NC]
    RewriteRule ^themes/.*\.(php\d?|phtml|phar|inc)$ - [R=404,L,NC]
    RewriteRule ^(wp-content|wp-includes)/.*\.(php\d?|phtml|phar)$ - [R=404,L,NC]
    RewriteRule ^(bin|scripts|tests|node_modules)(/.*)?$ - [R=404,L,NC]
    RewriteRule ^admin/(views|routes|install\.php|routes\.php|api\.php)(/.*)?$ - [R=404,L,NC]

    # Serve existing static files directly
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Everything else → front controller
    RewriteRule ^ index.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    <FilesMatch "\.(css|js|webp|avif|jpg|jpeg|png|gif|svg|woff2?|ico|mp4|webm)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/xml text/plain image/svg+xml
</IfModule>
