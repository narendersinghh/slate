<?php
// Test site for tests/page-editor.spec.mjs: php bin/ci-page-editor  (prints JSON with ids/urls)
declare(strict_types=1);
if (PHP_SAPI !== 'cli') {
    exit(1);
}
$root = dirname(__DIR__);
require $root . '/core/bootstrap.php';

use Slate\Auth;
use Slate\DB;
use Slate\HtmlPages;
use Slate\Options;
use Slate\Posts;

DB::connect(SLATE_CONFIG['db']);
Options::load();

// php bin/ci-page-editor content <id>: an item's stored content, title, fields (to check what a save changed)
if (($argv[1] ?? '') === 'content') {
    $p = Posts::find((int)($argv[2] ?? 0));
    echo json_encode($p ? ['title' => $p['title'], 'content' => $p['content'], 'fields' => $p['fields'], 'featured' => $p['featured_media_id'] ? (int)$p['featured_media_id'] : null] : null, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE), "\n";
    exit;
}
if (($argv[1] ?? '') === 'term') {
    $t = \Slate\Terms::find((int)($argv[2] ?? 0));
    echo json_encode($t ? ['name' => $t['name'], 'fields' => $t['fields']] : null, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE), "\n";
    exit;
}

// A 1x1-ish PNG the page refers to (the editor test uploads its own).
$png = base64_decode('iVBORw0KGgoAAAANSUhEUgAAABgAAAAQCAIAAACDRijCAAAAJklEQVR4nGP8z0AdwEQlc0YNGjVo1KBRg0YNGjVo1KBRg0YNAgB0VgEf9q3JIQAAAABJRU5ErkJggg==');
@mkdir(SLATE_ROOT . '/content/uploads', 0775, true);
file_put_contents(SLATE_ROOT . '/content/uploads/pe-photo.png', $png);

$admin = DB::row('SELECT * FROM {{users}} WHERE username = :u', ['u' => 'citest']);
Auth::actAs($admin);
Options::set('revisions_keep', 25);

// Blog posts for "Make dynamic".
foreach (['Dyn post one', 'Dyn post two', 'Dyn post three', 'Dyn post four'] as $i => $t) {
    if (!Posts::findBySlug('post', \slugify($t), false)) {
        Posts::save(['type' => 'post', 'title' => $t, 'content' => '<p>Body of ' . $t . '.</p>', 'excerpt' => 'Excerpt of ' . $t, 'status' => 'publish',
            'published_at' => date('Y-m-d H:i:s', time() - 3600 * (10 - $i))]);
    }
}

$res = HtmlPages::fromDocument((string)file_get_contents($root . '/tests/fixtures/page-editor/sample.html'));
$slug = 'editor-test-' . substr(bin2hex(random_bytes(3)), 0, 6);
$id = Posts::save(['type' => 'page', 'title' => $res['title'] ?: 'Editor test', 'slug' => $slug, 'status' => 'publish', 'author_id' => (int)$admin['id'],
    'content' => HtmlPages::text($res['data']['body']), 'fields' => ['_html' => $res['data']]]);

// A team member who may not edit this page (author role, not the page's author).
if (!DB::val('SELECT id FROM {{users}} WHERE username = :u', ['u' => 'peauthor'])) {
    DB::insert('users', ['username' => 'peauthor', 'email' => 'peauthor@example.test', 'password' => Auth::hash('author-password-123'),
        'display_name' => 'PE Author', 'role' => 'author', 'status' => 'active', 'created_at' => date('Y-m-d H:i:s')]);
}
// Pages that are not designed pages: stored content (WordPress-like HTML) shown by a Template and by the theme.
\Slate\ContentModel::saveFieldGroup(['id' => 'pe_page_fields', 'title' => 'Page extras', 'location' => ['post_types' => ['page'], 'taxonomies' => ['category']],
    'fields' => [['name' => 'subtitle', 'label' => 'Subtitle', 'type' => 'text'], ['name' => 'lead', 'label' => 'Lead', 'type' => 'textarea']]]);
$stored = (string)file_get_contents($root . '/tests/fixtures/page-editor/stored-content.html');
$sfx = substr(bin2hex(random_bytes(3)), 0, 6);
$tmp = tempnam(sys_get_temp_dir(), 'pe');
file_put_contents($tmp, $png);
$feature = \Slate\Media::upload(['name' => 'pe-feature.png', 'tmp_name' => $tmp, 'error' => UPLOAD_ERR_OK, 'size' => strlen($png)], true);
$tplId = Posts::save(['type' => 'page', 'title' => 'Template page', 'slug' => 'pe-tpl-' . $sfx, 'status' => 'publish', 'author_id' => (int)$admin['id'],
    'content' => $stored, 'fields' => ['subtitle' => 'A subtitle'], 'featured_media_id' => $feature['ok'] ? (int)$feature['media']['id'] : null]);
\Slate\Templates::save(['id' => 'pepagetpl', 'name' => 'PE page', 'kind' => 'single', 'target' => 'page__pe-tpl-' . $sfx, 'wrap' => true, 'enabled' => true,
    'html' => '<section class="pe-t"><h1 class="t-title">{{title|texturize}}</h1><p class="t-sub">{{field:subtitle}}</p>'
        . '<img class="t-alt" alt="{{title}}" src="/content/uploads/pe-photo.png"><figure class="t-fig">{{image}}</figure><div class="t-body">{{{content}}}</div>'
        . '<div class="t-list">{{#query type=post limit=2 orderby=title order=asc}}<h3 class="t-item">{{title}}</h3>{{/query}}</div></section>']);
$themeId = Posts::save(['type' => 'page', 'title' => 'Theme page', 'slug' => 'pe-theme-' . $sfx, 'status' => 'publish', 'author_id' => (int)$admin['id'], 'content' => $stored]);
$cat = \Slate\Terms::findBySlug('category', 'pe-topic');
$catId = $cat ? (int)$cat['id'] : \Slate\Terms::save('category', ['name' => 'PE Topic', 'slug' => 'pe-topic', 'fields' => ['lead' => "Topic lead's text"]]);
\Slate\Terms::save('category', ['name' => 'PE Topic', 'slug' => 'pe-topic', 'fields' => ['lead' => "Topic lead's text"]], $catId);
\Slate\Templates::save(['id' => 'petermtpl', 'name' => 'PE topics', 'kind' => 'term', 'target' => 'category', 'wrap' => true, 'enabled' => true,
    'html' => '<section class="pe-term"><h1 class="tt">{{term.name}}</h1><p class="tl">{{term.field:lead}}</p></section>']);

echo json_encode(['id' => $id, 'url' => Posts::permalink(Posts::find($id)), 'body' => Posts::find($id)['fields']['_html']['body'],
    'tpl' => ['id' => $tplId, 'url' => Posts::permalink(Posts::find($tplId))], 'theme' => ['id' => $themeId, 'url' => Posts::permalink(Posts::find($themeId))],
    'term' => ['id' => $catId, 'url' => \Slate\Terms::link(\Slate\Terms::find($catId))], 'stored' => $stored], JSON_UNESCAPED_SLASHES), "\n";
