<?php
// Fake AI provider for tests (Claude Messages API and OpenAI-compatible chat). Never used by a real site.
//   php -S 127.0.0.1:8097 bin/mock-ai
// Then point Settings → AI at http://127.0.0.1:8097/v1 (provider "anthropic" or "custom").
declare(strict_types=1);

$in = json_decode((string)file_get_contents('php://input'), true) ?: [];
$path = parse_url($_SERVER['REQUEST_URI'] ?? '/', PHP_URL_PATH);
$prompt = '';
foreach ((array)($in['messages'] ?? []) as $m) {
    if (($m['role'] ?? '') === 'user') {
        $prompt = is_string($m['content']) ? $m['content'] : json_encode($m['content']);
    }
}
$system = (string)($in['system'] ?? '');
foreach ((array)($in['messages'] ?? []) as $m) {
    if (($m['role'] ?? '') === 'system') {
        $system .= is_string($m['content']) ? $m['content'] : '';
    }
}
if (str_contains($prompt, 'Reply with the single word: ready')) {
    $html = 'ready';
} elseif (str_contains($system, 'You are Goraiya')) {
    $page = '<!doctype html><html lang="en"><head><title>Our Services</title><meta name="description" content="What we offer.">'
        . '<style>body{font-family:var(--font-body,system-ui);margin:0}.hero{padding:64px 24px;text-align:center;background:var(--color-primary,#f26b2d);color:#fff}'
        . '.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:20px;padding:40px 24px}.card{border:1px solid #ddd;border-radius:12px;padding:20px}</style>'
        . '<script>window.bad=1</script></head><body><section class="hero"><h1>Services that grow your business</h1><p>Clear plans, honest prices.</p><a class="btn" href="#contact">Talk to us</a></section>'
        . '<section class="cards"><div class="card"><h3>Strategy</h3><p>We map your next steps.</p></div><div class="card"><h3>Design</h3><p>Pages people trust.</p></div>'
        . '<div class="card"><h3>Growth</h3><p>More of the right visitors.</p></div></section></body></html>';
    $html = json_encode(['reply' => 'I made a Services page as a draft. Open it to check the copy.', 'actions' => [['type' => 'create_page', 'title' => 'Services', 'html' => $page]]]);
} elseif (str_contains($prompt, 'You edit one section of a web page') && preg_match('/^PARTS: (.+)$/m', $prompt, $pm)) {
    // Page editor, Goraiya on a section: rewrite every text (one with HTML the editor must strip), alt texts, and add a list item when asked.
    $parts = json_decode($pm[1], true) ?: [];
    $texts = $alts = [];
    $lists = [];
    foreach ($parts as $i => $p) {
        if ($p['type'] === 'text') {
            $texts[$p['id']] = 'Revamped: ' . trim(strip_tags($p['text'])) . ($i === 0 ? ' <strong>now</strong><script>alert(1)</script><img src=x onerror=alert(1)>' : '');
        } elseif ($p['type'] === 'image') {
            $alts[$p['id']] = 'Revamped alt';
        } elseif ($p['type'] === 'list' && str_contains($prompt, 'add a') && $p['items'] > 0) {
            $lists[] = ['id' => $p['id'], 'action' => 'duplicate', 'index' => 0];
        }
    }
    $html = "Here you go:\n" . json_encode(['texts' => $texts, 'alts' => $alts, 'lists' => $lists]);
} elseif (str_contains($prompt, 'This is a single element of a web page')) {
    $html = "Short \u{2014} and <strong>sweet</strong><script>alert(1)</script>";
} elseif (str_contains($prompt, 'Write alt text for an image')) {
    $html = 'A small orange test picture';
} elseif (str_contains($prompt, 'Rewrite this part')) {
    $html = '<div class="edited-by-ai" style="display:flex;gap:16px;flex-wrap:wrap"><p style="flex:1 1 200px">Edited by AI: shorter and clearer.</p></div>';
} elseif (str_contains($prompt, 'Design ONE new section')) {
    $html = '<section class="section"><div class="container"><h2>What our clients say</h2><blockquote style="margin:0">"Fast, friendly and on time."</blockquote></div></section>';
} else {
    $html = "```html\n" . '<section class="section" style="text-align:center"><div class="container"><p class="eyebrow">Free consultation</p><h1>Grow your business with a clear plan</h1>'
        . '<p style="max-width:620px;margin:16px auto 24px">A 30-minute call to find your next three steps.</p><a class="btn" href="#book" onclick="alert(1)">Book a call</a></div></section>'
        . '<section class="section"><div class="container" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:24px">'
        . '<div><h3>Listen</h3><p>We learn how you work today.</p></div><div><h3>Plan</h3><p>You get a short written plan.</p></div>'
        . '<div><img src="" alt="Team meeting" data-ai-image="people planning at a table" style="width:100%;height:auto"></div></div></section>'
        . '<script>alert("x")</script>' . "\n```";
}
header('Content-Type: application/json');
if (str_ends_with((string)$path, '/messages')) {
    echo json_encode(['id' => 'msg_mock', 'type' => 'message', 'role' => 'assistant', 'model' => $in['model'] ?? 'mock',
        'content' => [['type' => 'text', 'text' => $html]], 'stop_reason' => 'end_turn', 'usage' => ['input_tokens' => 1, 'output_tokens' => 1]]);
} else {
    echo json_encode(['id' => 'chatcmpl-mock', 'object' => 'chat.completion', 'choices' => [['index' => 0, 'message' => ['role' => 'assistant', 'content' => $html], 'finish_reason' => 'stop']]]);
}
