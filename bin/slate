#!/usr/bin/env php
<?php
/**
 * Slate command-line tool.
 *
 *   php bin/slate cache:clear
 *   php bin/slate module:list | module:make <slug> [--name="My module"] | module:install <url|file.zip> [--replace]
 *        module:activate <slug> | module:deactivate <slug> | module:update <slug> | module:check <slug> | module:delete <slug>
 *        module:export <slug> [--to=file.zip]
 *   php bin/slate safe-mode:on | safe-mode:off       start without modules (rescue a broken site)
 *   php bin/slate cron [--force] [--job=name] [--verbose]   run scheduled tasks (add to the server's crontab)
 *   php bin/slate admin:url [slug] | admin:host <host|off> | admin:ips "<ip cidr …>|off"   where the dashboard answers
 *   php bin/slate integrity:check [--notify] | integrity:trust [path]   file tampering check
 *   php bin/slate backup:create [--files] | backup:list | backup:restore <file> [--yes]
 *   php bin/slate version
 *
 * Modules add their own commands with the "cli_commands" filter:
 *   Hooks::add('cli_commands', fn(array $c) => $c + ['shop:sync' => ['Sync stock', function (array $opts, string $arg, callable $out, callable $fail): void { … }]]);
 */
declare(strict_types=1);

if (PHP_SAPI !== 'cli') {
    http_response_code(404);
    exit;
}

require dirname(__DIR__) . '/core/bootstrap.php';

use Slate\DB;
use Slate\Modules;
use Slate\Options;
use Slate\PageCache;

$argvList = array_slice($argv, 1);
$cmd = $argvList[0] ?? 'help';
$opts = [];
foreach (array_slice($argvList, 1) as $a) {
    if (preg_match('/^--([a-z-]+)(?:=(.*))?$/', $a, $m)) {
        $opts[$m[1]] = $m[2] ?? true;
    }
}
$arg = isset($argvList[1]) && !str_starts_with($argvList[1], '--') ? $argvList[1] : '';
$out = static function (string $s): void {
    fwrite(STDOUT, $s . PHP_EOL);
};
$fail = static function (string $s): never {
    fwrite(STDERR, "✕ $s" . PHP_EOL);
    exit(1);
};

if (!defined('SLATE_CONFIG')) {
    $fail('Slate is not installed yet (config.php missing). Run the web installer first.');
}
DB::connect(SLATE_CONFIG['db']);
Options::load();
\Slate\Schema::migrate();
Modules::boot();
\Slate\Theme::boot();

switch ($cmd) {
    case 'version':
        $out('Slate ' . SLATE_VERSION);
        break;

    case 'cache:clear':
        PageCache::clear();
        $out('✓ Cache refreshed. Outdated files are removed in the background (or now: php bin/slate cron --job=cache_sweep --force).');
        break;

    case 'module:list':
        $updates = \Slate\ModuleInstaller::updates(true);
        foreach (Modules::all(true) as $slug => $m) {
            $out(sprintf('%s %-26s %-9s %s%s', $m['active'] ? '●' : '○', $slug, $m['version'], $m['name'],
                isset($updates[$slug]) ? '  (update: ' . $updates[$slug]['version'] . ')' : ''));
        }
        foreach (Modules::errors() as $slug => $e) {
            $out("! $slug was switched off: {$e['message']}");
        }
        break;

    case 'module:make':
        $slug = slugify($arg);
        if (!Modules::validSlug($slug)) {
            $fail('Usage: php bin/slate module:make <slug> [--name="My module"] [--description="…"]');
        }
        $r = \Slate\ModuleInstaller::fromFiles($slug, \Slate\ModuleBuilder::scaffold($slug, (string)($opts['name'] ?? ucwords(str_replace('-', ' ', $slug))),
            (string)($opts['description'] ?? ''), true));
        $r['ok'] ? $out("✓ Created modules/$slug/ — edit module.php, then: php bin/slate module:activate $slug") : $fail($r['error']);
        break;

    case 'module:install':
        if ($arg === '') {
            $fail('Usage: php bin/slate module:install <https://github.com/… | https://….zip | ./file.zip> [--replace] [--sha256=…]');
        }
        $r = is_file($arg)
            ? \Slate\ModuleInstaller::fromZip($arg, null, !empty($opts['replace']), null, '', null, basename($arg))
            : \Slate\ModuleInstaller::fromUrl($arg, isset($opts['sha256']) ? (string)$opts['sha256'] : null, !empty($opts['replace']));
        if (!$r['ok']) {
            $fail($r['error']);
        }
        $out('✓ ' . ($r['updated'] ? 'Updated' : 'Installed') . " {$r['slug']} {$r['version']}");
        foreach ($r['scan']['findings'] as $f) {
            $out("  [{$f['risk']}] {$f['label']}");
        }
        $out("  Activate with: php bin/slate module:activate {$r['slug']}");
        break;

    case 'module:activate':
        ($err = Modules::activate($arg)) ? $fail($err) : $out("✓ Activated $arg");
        break;

    case 'module:deactivate':
        ($err = Modules::deactivate($arg, !empty($opts['force']))) ? $fail($err) : $out("✓ Deactivated $arg");
        break;

    case 'module:update':
        $r = \Slate\ModuleInstaller::update($arg);
        $r['ok'] ? $out("✓ Updated $arg to {$r['version']}") : $fail($r['error']);
        Modules::maintain();
        break;

    case 'module:delete':
        $r = \Slate\ModuleInstaller::delete($arg, !empty($opts['purge']));
        $r['ok'] ? $out("✓ Deleted $arg (backup: {$r['backup']})") : $fail($r['error']);
        break;

    case 'module:export':
        $file = \Slate\ModuleInstaller::export($arg);
        if (!$file) {
            $fail("Could not export $arg (not installed, or the zip extension is missing).");
        }
        $to = (string)($opts['to'] ?? basename($file));
        if (!@rename($file, $to) && !@copy($file, $to)) {
            $fail("Cannot write $to");
        }
        \Slate\Updater::rrmdir(dirname($file));
        $out("✓ Exported $arg to $to — install it elsewhere with: php bin/slate module:install $to");
        break;

    case 'module:check':
        if (!Modules::get($arg)) {
            $fail("Module $arg is not installed.");
        }
        $scan = \Slate\ModuleScanner::scan(SLATE_MODULES . "/$arg");
        $out("{$scan['files']} PHP files checked.");
        foreach ($scan['errors'] as $e) {
            $out("  ✕ $e");
        }
        foreach ($scan['findings'] as $f) {
            $out(sprintf('  [%s] %s — %s', $f['risk'], $f['label'], implode(', ', $f['where'])));
        }
        if (!$scan['errors'] && !$scan['findings']) {
            $out('  Nothing notable.');
        }
        exit($scan['errors'] ? 1 : 0);

    case 'cron':
        $res = \Slate\Cron::run(!empty($opts['force']), 'server', isset($opts['job']) ? (string)$opts['job'] : null);
        if (!empty($opts['verbose'])) {
            foreach ($res as $job => $r) {
                $out(sprintf('  %-22s %s', $job, $r));
            }
        }
        $failed = array_filter($res, static fn($r) => $r !== 'ok' && $r !== 'skipped');
        exit($failed ? 1 : 0);

    case 'backup:create':
        $r = \Slate\Backup::create(!empty($opts['files']));
        if (!$r['ok']) {
            $fail($r['error']);
        }
        \Slate\Backup::prune();
        foreach ($r['files'] as $f) {
            $out('✓ ' . $f . ' (' . format_bytes((int)filesize($f)) . ')');
        }
        break;

    case 'backup:list':
        foreach (\Slate\Backup::list() as $b) {
            $out(sprintf('%-40s %-9s %10s  %s', $b['name'], $b['kind'], format_bytes($b['size']), gmdate('Y-m-d H:i', $b['time'])));
        }
        break;

    case 'backup:restore':
        if ($arg === '') {
            $fail('Usage: php bin/slate backup:restore site-YYYYmmdd-His-db.sql.gz [--yes]');
        }
        if (empty($opts['yes'])) {
            fwrite(STDOUT, "This replaces the whole database with $arg (a safety backup is made first). Type RESTORE to continue: ");
            if (trim((string)fgets(STDIN)) !== 'RESTORE') {
                $fail('Cancelled.');
            }
        }
        $r = \Slate\Backup::restoreDatabase(basename($arg));
        $r['ok'] ? $out("✓ Restored {$r['statements']} statements. Safety backup: {$r['safety']}") : $fail($r['error']);
        break;

    case 'integrity:check':
        $r = \Slate\Integrity::check(!empty($opts['notify']));
        $out(($r['official'] ? "Core verified against GitHub ({$r['official']})" : 'Official file list unavailable; compared with the trusted snapshot') . " · {$r['files']} files");
        foreach ($r['issues'] as $i) {
            $out(sprintf('  [%s] %-9s %s — %s', $i['level'], $i['kind'], $i['path'], $i['detail']));
        }
        $out($r['issues'] ? count($r['issues']) . ' finding(s).' : '✓ No unexpected file changes.');
        exit(array_filter($r['issues'], static fn($i) => $i['level'] === 'danger') ? 2 : 0);

    case 'integrity:trust':
        $out('✓ Trusted ' . \Slate\Integrity::trust($arg) . ' files' . ($arg !== '' ? " under $arg" : '') . '.');
        break;

    case 'admin:url':
        // php bin/slate admin:url            show the dashboard address
        // php bin/slate admin:url studio-x7  move the dashboard to /studio-x7
        if ($arg !== '') {
            if (!preg_match('/^[a-z0-9-]{3,40}$/', $arg) || in_array($arg, ['api', 'content', 'themes', 'modules', 'core', 'bin'], true)) {
                $fail('Use 3–40 lowercase letters, numbers or dashes (not a reserved folder name).');
            }
            Options::set('security_admin_slug', $arg);
            PageCache::clear();
        }
        $out('Dashboard: ' . \Slate\AdminAccess::baseUrl() . '/' . admin_slug() . '/login');
        foreach (\Slate\AdminAccess::allowedIps() ? ['Only from: ' . implode(', ', \Slate\AdminAccess::allowedIps())] : [] as $l) {
            $out($l);
        }
        break;

    case 'admin:host':
        // php bin/slate admin:host cms.example.com | off
        if ($arg === '') {
            $out('Admin host: ' . (\Slate\AdminAccess::adminHost() ?: '(any host)'));
            break;
        }
        $host = strtolower($arg) === 'off' ? null : strtolower(preg_replace('#^https?://|/.*$#', '', $arg));
        if ($host !== null && !preg_match('/^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$/', $host)) {
            $fail('Not a valid host name.');
        }
        ($e = \Slate\AdminAccess::setConfig('admin_host', $host)) ? $fail($e) : $out($host ? "✓ The dashboard now answers only on https://$host/" . admin_slug() . '/' : '✓ The dashboard answers on any host again.');
        break;

    case 'admin:ips':
        // php bin/slate admin:ips "203.0.113.7 10.0.0.0/8" | off
        if ($arg === '') {
            $out('Allowed: ' . (implode(', ', \Slate\AdminAccess::allowedIps()) ?: '(everyone)'));
            break;
        }
        $ips = strtolower($arg) === 'off' ? null : array_values(array_filter(preg_split('/[\s,]+/', $arg) ?: []));
        foreach ((array)$ips as $ip) {
            [$n, $b] = array_pad(explode('/', $ip, 2), 2, null);
            if (@inet_pton($n) === false || ($b !== null && !ctype_digit($b))) {
                $fail("Not an IP or CIDR range: $ip");
            }
        }
        ($e = \Slate\AdminAccess::setConfig('admin_ips', $ips)) ? $fail($e) : $out($ips ? '✓ Dashboard limited to ' . implode(', ', $ips) : '✓ Dashboard reachable from any address.');
        break;

    case 'safe-mode:on':
        file_put_contents(SLATE_CONTENT . '/safe-mode', 'Created ' . gmdate('c') . "\n");
        PageCache::clear();
        $out('✓ Safe mode on: the site runs without modules until you run safe-mode:off.');
        break;

    case 'safe-mode:off':
        @unlink(SLATE_CONTENT . '/safe-mode');
        PageCache::clear();
        $out('✓ Safe mode off: modules load again.');
        break;

    default:
        $commands = (array)\Slate\Hooks::filter('cli_commands', []);
        if (isset($commands[$cmd]) && is_callable($commands[$cmd][1] ?? null)) {
            ($commands[$cmd][1])($opts, $arg, $out, $fail);
            break;
        }
        if ($cmd !== 'help') {
            fwrite(STDERR, "Unknown command: $cmd" . PHP_EOL . PHP_EOL);
        }
        $extra = '';
        foreach ($commands as $name => $c) {
            $extra .= sprintf("\n  php bin/slate %-58s %s", $name, (string)($c[0] ?? ''));
        }
        $out("Slate CLI\n\n  php bin/slate cache:clear                                              Clear the page cache\n  php bin/slate module:list | module:make <slug> | module:install <url|zip> | module:activate <slug>\n  php bin/slate module:deactivate <slug> | module:update <slug> | module:check <slug> | module:delete <slug>\n  php bin/slate module:export <slug> [--to=file.zip]                     Package a module for reuse\n  php bin/slate safe-mode:on | safe-mode:off                             Start without modules\n  php bin/slate cron [--force] [--verbose]                               Run scheduled tasks (server crontab)\n  php bin/slate backup:create [--files] | backup:list | backup:restore <file>\n  php bin/slate admin:url [slug] | admin:host <host|off> | admin:ips \"<ips>|off\"   Dashboard access\n  php bin/slate integrity:check | integrity:trust [path]                File tampering check\n  php bin/slate version" . ($extra !== '' ? "\n\nFrom modules:$extra" : ''));
}
