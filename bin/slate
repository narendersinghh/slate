#!/usr/bin/env php
<?php
/**
 * Slate command-line tool.
 *
 *   php bin/slate import:wordpress --url=https://example.com --user=admin [--password=APP_PASSWORD]
 *        [--no-design] [--no-theme] [--no-media] [--no-drafts] [--types=post,page,...] [--fresh]
 *   php bin/slate cache:clear
 *   php bin/slate module:list | module:make <slug> [--name="My module"] | module:install <url|file.zip> [--replace]
 *        module:activate <slug> | module:deactivate <slug> | module:update <slug> | module:check <slug> | module:delete <slug>
 *   php bin/slate safe-mode:on | safe-mode:off       start without modules (rescue a broken site)
 *   php bin/slate version
 *
 * The password can also be given via the WP_APP_PASSWORD environment variable, or typed when prompted
 * (recommended: it then never appears in your shell history).
 */
declare(strict_types=1);

if (PHP_SAPI !== 'cli') {
    http_response_code(404);
    exit;
}

require dirname(__DIR__) . '/core/bootstrap.php';

use Slate\Crypto;
use Slate\DB;
use Slate\Modules;
use Slate\Options;
use Slate\PageCache;
use SlateModules\WpImport\Importer;

$argvList = array_slice($argv, 1);
$cmd = $argvList[0] ?? 'help';
$opts = [];
foreach (array_slice($argvList, 1) as $a) {
    if (preg_match('/^--([a-z-]+)(?:=(.*))?$/', $a, $m)) {
        $opts[$m[1]] = $m[2] ?? true;
    }
}
$arg = isset($argvList[1]) && !str_starts_with($argvList[1], '--') ? $argvList[1] : '';
$out = static function (string $s): void {
    fwrite(STDOUT, $s . PHP_EOL);
};
$fail = static function (string $s): never {
    fwrite(STDERR, "✕ $s" . PHP_EOL);
    exit(1);
};

if (!defined('SLATE_CONFIG')) {
    $fail('Slate is not installed yet (config.php missing). Run the web installer first.');
}
DB::connect(SLATE_CONFIG['db']);
Options::load();
\Slate\Schema::migrate();
Modules::boot();
\Slate\Theme::boot();

switch ($cmd) {
    case 'version':
        $out('Slate ' . SLATE_VERSION);
        break;

    case 'cache:clear':
        $out('Cleared ' . PageCache::clear() . ' cached pages.');
        break;

    case 'import:wordpress':
        $url = (string)($opts['url'] ?? '');
        $user = (string)($opts['user'] ?? '');
        $pass = (string)($opts['password'] ?? (getenv('WP_APP_PASSWORD') ?: ''));
        if ($url === '') {
            $fail('Missing --url=https://your-wordpress-site.com');
        }
        if ($user !== '' && $pass === '') {
            fwrite(STDOUT, 'WordPress application password for ' . $user . ': ');
            if (DIRECTORY_SEPARATOR === '/') {
                @shell_exec('stty -echo 2>/dev/null');
            }
            $pass = trim((string)fgets(STDIN));
            if (DIRECTORY_SEPARATOR === '/') {
                @shell_exec('stty echo 2>/dev/null');
            }
            fwrite(STDOUT, PHP_EOL);
        }
        foreach (['auto-cpt-generator', 'wordpress-importer'] as $m) {
            if (!Modules::isActive($m)) {
                if ($err = Modules::activate($m)) {
                    $fail("Could not activate $m: $err");
                }
                $out("✓ Activated module: $m");
            }
        }
        require_once SLATE_MODULES . '/wordpress-importer/module.php';
        Importer::install();
        if (!empty($opts['fresh'])) {
            Importer::reset(true);
            $out('✓ Removed previously imported content (--fresh)');
        }
        @set_time_limit(0);
        $conn = ['source' => 'rest', 'url' => $url, 'user' => $user, 'pass' => Crypto::encrypt(preg_replace('/\s+/', '', $pass))];
        $out("→ Analysing $url …");
        try {
            $scan = Importer::scan($conn);
        } catch (Throwable $e) {
            $fail($e->getMessage());
        }
        $s = $scan['summary'];
        $conn['url'] = $s['url'];
        $out('  Site: ' . $s['site'] . ($s['auth'] ? '  (signed in as ' . $s['user'] . ')' : '  (public access only — drafts, menus and settings need an application password)'));
        foreach ($scan['counts']['types'] ?? [] as $wp => $c) {
            $out(sprintf('  %-22s %5d  → %s', $wp, $c['total'], $c['slug']));
        }
        $out(sprintf('  %-22s %5s', 'media', (string)($s['media'] ?? '?')));
        $out('  Detected: ' . (implode(', ', array_filter([$s['elementor'] ? 'Elementor' : null, $s['seo'] ?: null, $s['acf'] ? 'ACF' : null])) ?: '—'));
        Options::set('wpi_conn', $conn, false);
        Options::set('wpi_scan', $scan, false);
        $types = !empty($opts['types']) ? array_map('trim', explode(',', (string)$opts['types'])) : array_keys($scan['counts']['types'] ?? []);
        $job = Importer::start($conn, $scan, [
            'types' => $types, 'model' => true, 'media' => empty($opts['no-media']), 'seo' => true, 'menus' => true, 'settings' => true,
            'redirects' => true, 'design' => empty($opts['no-design']), 'activate_theme' => empty($opts['no-theme']) && empty($opts['no-design']),
            'drafts' => empty($opts['no-drafts']),
        ]);
        $out('→ Importing (' . count($job['steps']) . ' steps) …');
        $shown = 0;
        do {
            try {
                $r = Importer::step();
            } catch (Throwable $e) {
                $fail($e->getMessage());
            }
            $all = Importer::job()['log'] ?? [];
            foreach (array_slice($all, $shown) as $line) {
                $out('  ' . $line);
            }
            $shown = count($all);
            fwrite(STDOUT, sprintf("\r  [%3d%%] %-60s", $r['progress'], mb_substr($r['step'], 0, 60)));
        } while (!$r['done']);
        $out(PHP_EOL . '✓ Import finished: ' . json_encode($r['stats']));
        $out('  Open ' . site_url() . ' to review. Re-run this command any time to sync changes (it updates, never duplicates).');
        break;

    case 'module:list':
        $updates = \Slate\ModuleInstaller::updates(true);
        foreach (Modules::all(true) as $slug => $m) {
            $out(sprintf('%s %-26s %-9s %s%s', $m['active'] ? '●' : '○', $slug, $m['version'], $m['name'],
                isset($updates[$slug]) ? '  (update: ' . $updates[$slug]['version'] . ')' : ''));
        }
        foreach (Modules::errors() as $slug => $e) {
            $out("! $slug was switched off: {$e['message']}");
        }
        break;

    case 'module:make':
        $slug = slugify($arg);
        if (!Modules::validSlug($slug)) {
            $fail('Usage: php bin/slate module:make <slug> [--name="My module"] [--description="…"]');
        }
        $r = \Slate\ModuleInstaller::fromFiles($slug, \Slate\ModuleBuilder::scaffold($slug, (string)($opts['name'] ?? ucwords(str_replace('-', ' ', $slug))),
            (string)($opts['description'] ?? ''), true));
        $r['ok'] ? $out("✓ Created modules/$slug/ — edit module.php, then: php bin/slate module:activate $slug") : $fail($r['error']);
        break;

    case 'module:install':
        if ($arg === '') {
            $fail('Usage: php bin/slate module:install <https://github.com/… | https://….zip | ./file.zip> [--replace] [--sha256=…]');
        }
        $r = is_file($arg)
            ? \Slate\ModuleInstaller::fromZip($arg, null, !empty($opts['replace']), null, '', null, basename($arg))
            : \Slate\ModuleInstaller::fromUrl($arg, isset($opts['sha256']) ? (string)$opts['sha256'] : null, !empty($opts['replace']));
        if (!$r['ok']) {
            $fail($r['error']);
        }
        $out('✓ ' . ($r['updated'] ? 'Updated' : 'Installed') . " {$r['slug']} {$r['version']}");
        foreach ($r['scan']['findings'] as $f) {
            $out("  [{$f['risk']}] {$f['label']}");
        }
        $out("  Activate with: php bin/slate module:activate {$r['slug']}");
        break;

    case 'module:activate':
        ($err = Modules::activate($arg)) ? $fail($err) : $out("✓ Activated $arg");
        break;

    case 'module:deactivate':
        ($err = Modules::deactivate($arg, !empty($opts['force']))) ? $fail($err) : $out("✓ Deactivated $arg");
        break;

    case 'module:update':
        $r = \Slate\ModuleInstaller::update($arg);
        $r['ok'] ? $out("✓ Updated $arg to {$r['version']}") : $fail($r['error']);
        Modules::maintain();
        break;

    case 'module:delete':
        $r = \Slate\ModuleInstaller::delete($arg, !empty($opts['purge']));
        $r['ok'] ? $out("✓ Deleted $arg (backup: {$r['backup']})") : $fail($r['error']);
        break;

    case 'module:check':
        if (!Modules::get($arg)) {
            $fail("Module $arg is not installed.");
        }
        $scan = \Slate\ModuleScanner::scan(SLATE_MODULES . "/$arg");
        $out("{$scan['files']} PHP files checked.");
        foreach ($scan['errors'] as $e) {
            $out("  ✕ $e");
        }
        foreach ($scan['findings'] as $f) {
            $out(sprintf('  [%s] %s — %s', $f['risk'], $f['label'], implode(', ', $f['where'])));
        }
        if (!$scan['errors'] && !$scan['findings']) {
            $out('  Nothing notable.');
        }
        exit($scan['errors'] ? 1 : 0);

    case 'safe-mode:on':
        file_put_contents(SLATE_CONTENT . '/safe-mode', 'Created ' . gmdate('c') . "\n");
        PageCache::clear();
        $out('✓ Safe mode on: the site runs without modules until you run safe-mode:off.');
        break;

    case 'safe-mode:off':
        @unlink(SLATE_CONTENT . '/safe-mode');
        PageCache::clear();
        $out('✓ Safe mode off: modules load again.');
        break;

    default:
        $out("Slate CLI\n\n  php bin/slate import:wordpress --url=https://example.com --user=admin   Import a WordPress site\n  php bin/slate cache:clear                                              Clear the page cache\n  php bin/slate module:list | module:make <slug> | module:install <url|zip> | module:activate <slug>\n  php bin/slate module:deactivate <slug> | module:update <slug> | module:check <slug> | module:delete <slug>\n  php bin/slate safe-mode:on | safe-mode:off                             Start without modules\n  php bin/slate version");
}
