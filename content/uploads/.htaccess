# Never execute scripts inside content/
<FilesMatch "\.(php\d?|phtml|phar|pl|py|cgi|sh|sqlite|log|zip|html?)$">
    Require all denied
</FilesMatch>
<FilesMatch "\.html$">
    Require all denied
</FilesMatch>
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .phar
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
