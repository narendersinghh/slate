# Slate CMS, example nginx server block
server {
    listen 80;
    server_name example.com;
    root /var/www/slate;
    index index.php;

    # Deny sensitive files
    location ~* ^/(config\.php|config\.sample\.php|\.git|.*\.md$) { return 404; }
    location ~ /\.(?!well-known/) { return 404; }
    location ~* /(module|theme)\.json$ { return 404; }
    location ~* \.(example|dist|bak|old|orig|save|swp|sql|gz|tgz|tar)$ { return 404; }
    location ~* \.(sqlite|log)$ { return 404; }
    location ~* ^/(core|modules|themes|content|wp-content|wp-includes)/.*\.(php\d?|phtml|phar|inc)$ { return 404; }
    # Old WordPress media & mirrored assets: serve if present, otherwise let Slate redirect / fetch them
    location ^~ /wp-content/ { try_files $uri /index.php?$query_string; }
    location ^~ /wp-includes/ { try_files $uri /index.php?$query_string; }
    location ~* ^/admin/(views|routes|install\.php|routes\.php|api\.php) { return 404; }
    location ^~ /content/cache/   { return 404; }
    location ^~ /bin/ { return 404; }
    location ~ ^/(scripts|tests|node_modules)/ { return 404; }
    location ~ ^/(package(-lock)?\.json|playwright\.config\.\w+)$ { return 404; }
    location ^~ /content/backups/ { return 404; }
    location ^~ /content/form-uploads/ { return 404; }

    # Long cache for static assets
    location ~* \.(css|js|webp|avif|jpg|jpeg|png|gif|svg|woff2?|ico|mp4|webm)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location / {
        try_files $uri /index.php?$query_string;
    }

    location = /index.php {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
    }
    location ~* \.(php\d?|phtml|phar)$ { return 404; }

    gzip on;
    gzip_types text/css application/javascript application/json application/xml text/plain image/svg+xml;
}
