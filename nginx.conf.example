# Slate CMS — example nginx server block
server {
    listen 80;
    server_name example.com;
    root /var/www/slate;
    index index.php;

    # Deny sensitive files
    location ~* ^/(config\.php|config\.sample\.php|\.git|.*\.md$) { deny all; }
    location ~* \.(sqlite|log)$ { deny all; }
    location ~* ^/(core|modules|themes|content|wp-content|wp-includes)/.*\.php$ { deny all; }
    # Old WordPress media & mirrored assets: serve if present, otherwise let Slate redirect / fetch them
    location ^~ /wp-content/ { try_files $uri /index.php?$query_string; }
    location ^~ /wp-includes/ { try_files $uri /index.php?$query_string; }
    location ~* ^/admin/(views|install\.php|routes\.php|api\.php) { deny all; }
    location ^~ /content/cache/   { deny all; }
    location ^~ /content/backups/ { deny all; }

    # Long cache for static assets
    location ~* \.(css|js|webp|avif|jpg|jpeg|png|gif|svg|woff2?|ico|mp4|webm)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location / {
        try_files $uri /index.php?$query_string;
    }

    location = /index.php {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
    }
    location ~ \.php$ { deny all; }

    gzip on;
    gzip_types text/css application/javascript application/json application/xml text/plain image/svg+xml;
}
